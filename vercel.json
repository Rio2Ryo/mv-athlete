{
  "framework": "vite",
  "buildCommand": "npm run build && mkdir -p dist/athlete && cp -r dist/assets dist/athlete/ && cp dist/index.html dist/athlete/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*).mp4",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/athlete",
      "destination": "/athlete/index.html"
    },
    {
      "source": "/athlete/(.*)",
      "destination": "/athlete/index.html"
    }
  ]
}
